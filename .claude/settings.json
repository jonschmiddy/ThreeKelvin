{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/dev/claude_hooks.sh\" bash-guard",
            "timeout": 10,
            "statusMessage": "Checking the command against the repo's rules..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tkg/tools/gdcheck.sh\"",
            "timeout": 60,
            "statusMessage": "Checking GDScript..."
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/dev/claude_hooks.sh\" edit-ratchets",
            "timeout": 30,
            "statusMessage": "Checking the code ratchets..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/dev/claude_hooks.sh\" stop-nudge",
            "timeout": 20,
            "statusMessage": "Checking that the change was verified..."
          }
        ]
      }
    ]
  }
}
