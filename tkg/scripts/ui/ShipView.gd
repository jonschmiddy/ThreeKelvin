## Clip names avoid `thruster_arrive_2`, which `Audio.play()` would read as a round-robin take.
## Why: docs/why/ShipView.md#flameout-table
const FLAMEOUT_SFX := [
	[&"thruster_arrive_light_a", &"thruster_arrive_light_b", &"thruster_arrive_light_c", &"thruster_arrive_light_d", &"thruster_arrive_light_e", &"thruster_arrive_light_f", &"thruster_arrive_light_g", &"thruster_arrive_light_h"],  ## LIGHT
	[&"thruster_arrive_medium_a", &"thruster_arrive_medium_b", &"thruster_arrive_medium_c", &"thruster_arrive_medium_d", &"thruster_arrive_medium_e", &"thruster_arrive_medium_f", &"thruster_arrive_medium_g", &"thruster_arrive_medium_h"],  ## MEDIUM
	[&"thruster_arrive_heavy_a", &"thruster_arrive_heavy_b", &"thruster_arrive_heavy_c", &"thruster_arrive_heavy_d", &"thruster_arrive_heavy_e", &"thruster_arrive_heavy_f", &"thruster_arrive_heavy_g", &"thruster_arrive_heavy_h"],  ## HEAVY
]
## And the drive coming UP, one per weight. No pattern here:
## nothing is gated, so there is nothing to stay in step with.
const DEPART_SFX: Array[StringName] = [&"thruster_depart_light", &"thruster_depart_medium", &"thruster_depart_heavy"]
## -- end of the generated table.
var _arrive_at: int = -1
## Which of FLAMEOUTS this approach is flying. Chosen in `arrive()` and handed
## back to the caller, because the sound has to be the clip for THIS row.
var _flameout: int = 0

## The run is measured from the nose to the slot's edge, as `ShipSlot` leaves that space empty.
## Why: docs/why/ShipView.md#departure
const DEPART_EDGE := 12.0
## The overrun past the slot happens in the last fifth, under the flare, so nothing overlaps.
## Why: docs/why/ShipView.md#departure
const DEPART_OVER := 150.0
## It is still accelerating at the flare: a ship that stops dead and flashes reads as deleted.
const DEPART_MS := 1080.0
var _depart_at: int = -1
var _depart_span: float = -1.0

## This class keeps no clock for the melt: `JumpFx` alone choreographs it, as two clocks drift.
## Why: docs/why/ShipView.md#hyperdrive
const HYPER_CORE := Color("#e4f2ff")
## 0 is a ship, 1 is a line where a ship was, -1 is not melting at all.
var _melt: float = -1.0
## The shudder moves the Control, not the canvas, since inside the canvas it would clip the hull.
const SHAKE_HZ := 30.0
var _shake: float = 0.0
var _shake_step: int = -1
## The spool look on the hull, from `JumpFx`; see set_spool.
var _spool_look: StringName = &"none"
var _spool: float = 0.0
var _spool_t: float = 0.0
## Hull extent is the opaque part, as the canvas has empty stern columns and a bar ran too long.
## Why: docs/why/ShipView.md#hull-extent
var _body_px := Rect2i()
## Cached per source texture: bounds do not move with wear, and a pass per bob step is waste.
static var _body_cache: Dictionary = {}
## The middle of the hull's body in image rows, from `_body_middle`; -1 until a
## sprite has been drawn. Cached per source texture for the same reason.
var _body_mid: float = -1.0
static var _mid_cache: Dictionary = {}
var _arrive_dx: int = 0
var _arrive_bob: int = 2
## How far left of its resting place the ship starts, in screen pixels. Measured
## on the first tick, once layout has actually happened.
var _arrive_span: int = 0
## Approach timing is in seconds, so an arrival is the same pictures at any clock moment.
var _arrive_from: int = 0
var _arrive_from_s := 0.0
var _arrive_at_s := 0.0
## The owner steps the approach on its own clock (a film or harness), so the two cannot drift.
var arrive_driven := false

## `delay` staggers a convoy, and the returned clip lets callers play the matching drive sound.
## Why: docs/why/ShipView.md#arrival
func arrive(bob_amp: int = 2, delay: float = 0.0) -> StringName:
	_flameout = randi() % FLAMEOUTS.size()
	_arrive_bob = maxi(0, bob_amp)
	_arrive_from_s = GameClock.now()
	_arrive_at_s = _arrive_from_s + maxf(0.0, delay)
	_arrive_from = int(_arrive_from_s * 1000.0)
	_arrive_at = int(_arrive_at_s * 1000.0)
	_arrive_dx = 0
	_arrive_span = 0
	_bob_amp = 0
	_bob_off = 0
	_burning = true
	# Unseen until off screen: the span waits for layout, so the ship flashed at its mooring.
	if _arrive_span <= 0 and visible:
		_arrive_hid = true
		visible = false
	_burn_thrust = ThrusterFx.Thrust.FULL
	_engines_off = false
	_arrive_window = 0
	set_process(true)
	refresh()
	return _flameout_clip()


## The clip follows the hull's weight, read per view, falling back to MEDIUM with no hull.
func _flameout_clip() -> StringName:
	var hull := _hull()
	var w := int(hull.weight) if hull != null else int(HullData.Weight.MEDIUM)
	return (FLAMEOUT_SFX[w] as Array)[_flameout]


## Undocking sputters down to idle (Jon, Oct 21): seen coughs and heard clip share one row.
## Why: docs/why/ShipView.md#standalone-flameout
var _sputter_e := -1.0


## Start the flameout of `row` (-1: one at random, as `arrive` picks): the
## engines' burn gone over to the coughs. Returns that row's clip.
func sputter(row: int = -1) -> StringName:
	_flameout = row if row >= 0 and row < FLAMEOUTS.size() else randi() % FLAMEOUTS.size()
	_burning = false
	_engines_off = false
	_sputter_e = (FLAMEOUTS[_flameout][0] as Vector2).y
	set_process(true)
	return _flameout_clip()


## The coughs `t` s after the first; past the last of them the idle, and done.
func sputter_step(t: float) -> void:
	if _sputter_e < 0.0:
		return
	var spans: Array = FLAMEOUTS[_flameout]
	var e := (spans[0] as Vector2).y + maxf(t, 0.0) * 1000.0 / ARRIVE_MS
	# (a hair short of the last cough's end is its end: the clock that steps it
	# lands there in floats)
	_sputter_e = e if e < (spans[-1] as Vector2).y - 0.0001 else -1.0


func sputtering() -> bool:
	return _sputter_e >= 0.0


## The flameout over now (its owner's move ended): the idle.
func sputter_stop() -> void:
	_sputter_e = -1.0


## How long `row`'s coughs last, s: from the end of its clean burn to the end of
## its last cough.
static func sputter_s(row: int) -> float:
	var spans: Array = FLAMEOUTS[row]
	return ((spans[-1] as Vector2).y - (spans[0] as Vector2).y) * ARRIVE_MS / 1000.0


## Where in `row`'s clip its first cough is, s (its lead, then its clean burn).
static func sputter_from_s(row: int) -> float:
	return ARRIVE_LEAD_S + (FLAMEOUTS[row][0] as Vector2).y * ARRIVE_MS / 1000.0

## Light the engines. Chassis select only; see _burning.
func burn(on: bool = true) -> void:
	_burning = on
	_burn_thrust = ThrusterFx.Thrust.CRUISE
	if on:
		set_process(true)
	refresh()

## Sliced frames, keyed by source texture and shared by every ShipView on
## screen. Slicing is done once per texture, not once per view.
static var _flame_cache: Dictionary = {}

## Harness films step a shot clock one step a saved frame; play uses `GameClock`.
## Why: docs/why/ShipView.md#film-clock
static var shot_clock := -1.0

## Opt in. `amp` is in source pixels, so it is multiplied by the magnification
## like everything else.
func bob(amp: int, hz: float = 0.3) -> void:
	_bob_amp = maxi(0, amp)
	_bob_hz = hz
	set_process(true)

func _ready_anim() -> void:
	# Every ship with engines burns, idle or more, so every one ticks.
	if _hull() != null and _hull().has_exhaust():
		set_process(true)

func _process(_delta: float) -> void:
	if _hull() == null:
		return
	var t := shot_clock if shot_clock >= 0.0 else GameClock.now()
	var dirty := false
	if _arrive_at >= 0 and not arrive_driven and _tick_arrival():
		dirty = true
	if _depart_at >= 0 and _tick_departure():
		dirty = true
	# Shudder steps at `SHAKE_HZ`: sixty times a second smears, thirty trembles.
	if _shake > 0.0:
		var step := int(t * SHAKE_HZ)
		if step != _shake_step:
			_shake_step = step
			var jit := int(round(_shake))
			position = Vector2(randi_range(-jit, jit), randi_range(-jit, jit))
	elif _shake_step >= 0:
		_shake_step = -1
		position = Vector2.ZERO
	if _bob_amp > 0:
		var off := int(round(sin(t * TAU * _bob_hz) * float(_bob_amp)))
		if off != _bob_off:
			_bob_off = off
			dirty = true
	# THE FLAME: its own layer, redrawn every frame (the loop holds its shapes
	# at 8 a second; the sparks move every frame), never a repaint of the hull.
	if _hull().has_exhaust() or HullGrade.key_for(_hull()) != "":
		_flame_layer.queue_redraw()
	# One repaint per change, so an animated ship costs about twenty redraws a second, not sixty.
	if dirty:
		refresh()

func _init() -> void:
	texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	# Odd centring puts the sprite on a half pixel and crawls it; keep the snap settings on.
	# Why: docs/why/ShipView.md#half-pixel-snap
	stretch_mode = TextureRect.STRETCH_KEEP_CENTERED
	custom_minimum_size = Vector2(_w, _h)
	_flame_layer = FlameLayer.new()
	(_flame_layer as FlameLayer).view = self
	_flame_layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_flame_layer.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	_flame_layer.material = ThrusterFx.add_material()
	_flame_layer.set_anchors_preset(Control.PRESET_FULL_RECT)
	add_child(_flame_layer, false, Node.INTERNAL_MODE_FRONT)
	_img = Image.create(_w, _h, false, Image.FORMAT_RGBA8)
	_tex = ImageTexture.create_from_image(_img)
	texture = _tex

## A fixed build is a snapshot, but a partner's is replaced on each roster push, so it is looked up.
## Why: docs/why/ShipView.md#whose-ship
var _fixed: ShipBuild = null
var _peer: int = 0

## Your own build is rebuilt on demand, so the ~20 repaints a second do not each rebuild it.
var _mine: ShipBuild = null

## The partner's build as it was at the last repaint. See _repaint_partner().
var _seen: ShipBuild = null

## Shared empty build so `_b()` is never null; one guard covers every use.
static var _NOBODY := ShipBuild.new()

## The ship this view draws. The one place that asks whose it is.
func _b() -> ShipBuild:
	if _fixed != null:
		return _fixed
	if _peer != 0:
		# Null until that player leaves chassis select: a state the convoy slot says out loud.
		var theirs := Net.build_of(_peer)
		return theirs if theirs != null else _NOBODY
	if _mine == null:
		_mine = ShipBuild.local()
	return _mine

## Headless `texture.get_image()` returns nothing, so the contact sheet used this image.
## Why: docs/why/ShipView.md#canvas-readback
func canvas() -> Image:
	return _img

## A snapshot of an outside build; nothing repaints it but a caller.
func show_build(b: ShipBuild) -> void:
	_fixed = b
	refresh()

## Looked up, not stored: a held reference would be last second's ship after a roster push.
func follow_peer(id: int) -> void:
	_peer = id
	if not Sig.party_changed.is_connected(_repaint_partner):
		Sig.party_changed.connect(_repaint_partner)
	_repaint_partner()

## Repaint only when that partner's build changed: a procedural hull is 15,000 pixels of GDScript.
## Why: docs/why/ShipView.md#partner-repaint
func _repaint_partner() -> void:
	var b := Net.build_of(_peer)
	if b == _seen:
		return
	_seen = b
	refresh()

## Magnify the image with NEAREST, as neither stretch mode scales the ship correctly when cropped.
## Why: docs/why/ShipView.md#magnification
var _k: int = 1

## Mounts use the hull's measured coordinates through this one transform, not a second set.
## Why: docs/why/ShipView.md#canvas-to-local
func canvas_to_local(p: Vector2) -> Vector2:
	var tex := Vector2(float(_w), float(_h)) * float(_k)
	var origin := ((size - tex) * 0.5).floor()
	# Points drop to the half sheet first, or convoy mounts sit at twice their offset.
	# Why: docs/why/ShipView.md#canvas-to-local
	var q := p * 0.5 if _half else p
	return origin + Vector2(q.x, q.y + float(_bob_amp + _bob_off)) * float(_k)

## How far the idle bob is currently displaced, in sprite pixels. Anything
## following the ship has to repaint when this changes.
func bob_offset() -> int:
	return _bob_off

## Anything drawn on the hull multiplies by this, or mounted modules looked like specks.
func zoom_level() -> int:
	return _k

## `art_scale()` is right on the half sheet; `zoom_level()` is out by two there.
## Why: docs/why/ShipView.md#art-scale
func art_scale() -> float:
	return float(_k) * (0.5 if _half else 1.0)

## A fitted part is sized in sprite pixels on purpose: matching the hold would oversize guns.
## Why: docs/why/ShipView.md#art-scale

## The half sheet is a second file, since `zoom()` cannot go below 1; set only on real change.
## Why: docs/why/ShipView.md#half-sheet
func use_half(on: bool) -> void:
	if _half == on:
		return
	_half = on
	refresh()

## Whether this view is drawing from the half sheet.
func is_half() -> bool:
	return _half

## The ship is off-centre in its canvas by the exhaust clearance, measured from opaque pixels.
## Why: docs/why/ShipView.md#ship-offset
func canvas_width() -> float:
	return float(_w * _k)

## And its height, for the same reason: a caller that wants to know whether it
## is cropping anything has to be able to ask how tall the thing being shown is.
func canvas_height() -> float:
	return float(_h * _k)

## Ink rect is in canvas coordinates; screens that scale and place the canvas need that frame.
## Why: docs/why/ShipView.md#ship-rect
func ink_rect() -> Rect2i:
	if _img == null:
		return Rect2i(0, 0, _w, _h)
	var r := _img.get_used_rect()
	if r.size.x <= 0 or r.size.y <= 0:
		return Rect2i(0, 0, _w, _h)
	r.position.y -= _bob_off
	return r


## THE SHIP AS DRAWN WHOLE, in global px: its hull's ink and every part bolted
## to it (`MountPoints.parts_rect`) -- turrets and pods stand off the hull.
func fitted_rect_global() -> Rect2:
	var ink := Rect2(ink_rect())
	var xf := get_global_transform()
	var r := Rect2(xf * canvas_to_local(ink.position), Vector2.ZERO).expand(xf * canvas_to_local(ink.end))
	for c in get_children():
		if c is MountPoints:
			var pr: Rect2 = (c as MountPoints).parts_rect()
			if pr.size.x > 0.0:
				var g := (c as Control).get_global_transform()
				r = r.merge(Rect2(g * pr.position, Vector2.ZERO).expand(g * pr.end))
	return r


## Measured off the opaque pixels, with the bob taken out so a box does not twitch.
func ship_rect() -> Rect2:
	var whole := Rect2(Vector2.ZERO, size)
	if _img == null:
		return whole
	var r := _img.get_used_rect()
	if r.size.x <= 0 or r.size.y <= 0:
		return whole
	# STRETCH_KEEP_CENTERED puts the canvas in the middle of the control.
	var origin := (size - Vector2(canvas_width(), canvas_height())) * 0.5
	var at := origin + Vector2(r.position) * float(_k)
	at.y -= float(_bob_off) * float(_k)
	return Rect2(at, Vector2(r.size) * float(_k))

## Bottom is measured from the hull, with the bob subtracted so readouts do not twitch.
## Why: docs/why/ShipView.md#ship-bottom
func ship_bottom_y() -> float:
	if _img == null:
		return 0.0
	var r := _img.get_used_rect()
	if r.size.y <= 0:
		return 0.0
	return (float(r.end.y) - float(bob_offset()) - float(_h) * 0.5) * float(_k)


func ship_offset_x() -> float:
	if _img == null:
		return 0.0
	var r := _img.get_used_rect()
	if r.size.x <= 0:
		return 0.0
	return (float(r.position.x) + float(r.size.x) * 0.5
		- float(_w) * 0.5) * float(_k)

## Magnifies without showroom mode, which would drop the live heat, damage and modules.
## Why: docs/why/ShipView.md#magnify-and-crop
func magnify(k: int, view_height: int) -> void:
	_k = maxi(1, k)
	# Remembered so the width re-fits when the canvas differs from the procedural 240.
	# Why: docs/why/ShipView.md#magnify-and-crop
	crop(_w * _k, view_height)
	# No clip when the box covers the canvas, or guns bolted to the last mount lose their muzzle.
	# Why: docs/why/ShipView.md#magnify-and-crop
	clip_contents = self_clip and view_height < _h * _k
	# After crop, which clears it, or the re-fit undoes `StationScreen`'s deliberate crop.
	_fit_h = view_height

## False on the refit screen, which clips in its own window so muzzles are not cut.
## Why: docs/why/ShipView.md#self-clip
var self_clip: bool = true

## `zoom()` sets no minimum size, which would fight the sector strip's anchors.
## Why: docs/why/ShipView.md#zoom-only
func zoom(k: int) -> void:
	_k = maxi(1, k)
	expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	refresh()

## Crop shows less of the canvas rather than scaling, as only integer magnification is allowed.
## Why: docs/why/ShipView.md#crop
func crop(view_width: int, view_height: int) -> void:
	# An explicit crop is a width the caller means. Only magnify() re-fits.
	_fit_h = 0
	_sized = true
	expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	custom_minimum_size = Vector2(view_width, view_height)
	clip_contents = self_clip
	refresh()

## The transfer screen needs a traded-in hull still wearing its parts, so a view of one build.
## Why: docs/why/ShipView.md#build-view
func setup_build(b: ShipBuild, k: int = 1) -> void:
	_fixed = b
	_k = maxi(1, k)
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	refresh()

func setup_preview(h: HullData, view_height: int = 0, k: int = 1) -> void:
	_fixed = ShipBuild.showroom(h)
	_k = maxi(1, k)
	# A showroom sprite is never the thing you click — the card around it is.
	mouse_filter = Control.MOUSE_FILTER_IGNORE
	if view_height > 0:
		# `EXPAND_IGNORE_SIZE` is needed, or the control claimed 120 rows and pushed labels out.
		# Why: docs/why/ShipView.md#preview-crop
		expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		custom_minimum_size = Vector2(_w * _k, view_height)
		clip_contents = self_clip
		_sized = true
	refresh()

func _hull() -> HullData:
	return _b().hull

func _ready() -> void:
	_ready_anim()
	# Only a view of your ship listens to its signals; other views change by other means.
	if _fixed == null and _peer == 0:
		Sig.ship_changed.connect(_restate)
		Sig.resources_changed.connect(_restate)
		Sig.player_combat_state_changed.connect(_restate)
	refresh()

## Your ship moved. Drop the cached build and repaint from the new one.
func _restate() -> void:
	_mine = null
	refresh()

func refresh() -> void:
	if _hull() == null:
		return
	if _hull().sprite != null:
		_blit_sprite()
	else:
		_resize_canvas(W, H)
		draw_ship()
	# set_image, not update: update() requires the same dimensions, and neither a
	# resized canvas nor a magnified copy matches what the texture last held.
	if _k <= 1:
		_tex.set_image(_img)
		return
	var up := _img.duplicate() as Image
	up.resize(_w * _k, _h * _k, Image.INTERPOLATE_NEAREST)
	_tex.set_image(up)

## Real art goes down whole; heat, damage and modules come from the shader and own sprites.
## Why: docs/why/ShipView.md#real-art
func arriving() -> bool:
	return _arrive_at >= 0


## The approach `t` seconds after `arrive`, on the caller's clock, as every arrival ticks.
func arrive_step(t: float) -> void:
	if _arrive_at >= 0 and _tick_arrival(_arrive_from_s + maxf(0.0, t)):
		refresh()


func _tick_arrival(now: float = -1.0) -> bool:
	if now < 0.0:
		now = GameClock.now()
	# The span starts off the screen: sliding inside the canvas made it pop in at the panel edge.
	if _arrive_span <= 0:
		if size.x <= 0.0:
			return false
		_arrive_span = int(ceil(global_position.x + size.x)) + 16
		position.x = -float(_arrive_span)
		_unhide_arrival()

	# Held off screen while waiting, so a staggered convoy does not show ships standing still.
	if now < _arrive_at_s:
		return false

	var e := (now - _arrive_at_s) * 1000.0 / ARRIVE_MS
	if e >= 1.0:
		park()
		return true

	var dirty := false
	# Ease-out cubic: it arrives with speed and gives it all up to the drift.
	var p := 1.0 - pow(1.0 - e, 3.0)
	var dx := int(round(lerpf(float(-_arrive_span), 0.0, p)))
	if dx != _arrive_dx:
		_arrive_dx = dx
		position.x = float(dx)
	var win := _flame_window(e)
	_arrive_window = win
	var lit := win >= 0
	if lit != _burning:
		_burning = lit
		dirty = true
	return dirty

## Returns the clip for this hull's weight, so four hulls leaving are not four thrusters.
func depart(hyper: bool = false) -> StringName:
	park()                      ## whatever the approach still owns, it stops owning
	_bob_amp = 0                ## rigid under power. A ship bobbing as it revs is idling.
	_bob_off = 0
	# No plumes under a hyperdrive: a charging jump drive with lit engines reads as idling.
	_burning = not hyper
	_burn_thrust = ThrusterFx.Thrust.FULL
	_engines_off = hyper
	_melt = -1.0
	# A hyperdrive does not move the hull, so there is nothing to tick: its melt
	# and shudder are pushed in from `JumpFx`, on that clock. See set_melt.
	_depart_at = -1 if hyper else GameClock.now_ms()
	_depart_span = -1.0
	set_process(true)
	refresh()
	var hull := _hull()
	var w := int(hull.weight) if hull != null else int(HullData.Weight.MEDIUM)
	return DEPART_SFX[w]

## Ease-in cubic mirrors the approach, driven from `_process` so one place owns the position.
## Why: docs/why/ShipView.md#departure
func _tick_departure() -> bool:
	# Measured on the first real layout tick, as the containers have not sorted at `depart()`.
	if _depart_span < 0.0:
		if size.x <= 0.0:
			return false
		var room := size.x
		var slot := get_parent() as Control
		if slot != null:
			room = slot.size.x - position.x
		var clear := maxf(room - hull_rect().end.x - DEPART_EDGE, 0.0)
		_depart_span = clear + DEPART_OVER
	var span := _depart_span
	var e := float(GameClock.now_ms() - _depart_at) / DEPART_MS
	if e >= 1.0:
		_depart_at = -1
		return false
	var dx := int(round(pow(e, 3.0) * span))
	return _shift(dx)

## How far the hull has gone to light, pushed in every frame by `ShipSlot` from
## the flare's own clock. See the HYPERDRIVE note.
func set_melt(v: float) -> void:
	if v < 0.0:
		return
	var m := clampf(v, 0.0, 1.0)
	if is_equal_approx(_melt, m):
		return
	_melt = m
	# The mounts leave with the ship: they are a child node, so they once hung in the air.
	_hide_fittings(m > 0.0)
	# Nothing left means nothing drawn: the last row once outlived the ship by half a second.
	visible = m < 1.0
	refresh()

## The shudder of a drive charging, in whole pixels.
func set_shake(px: float) -> void:
	_shake = maxf(px, 0.0)
	set_process(true)

## The spool look draws on the hull's own pixels, whole pixels and cold light, like the melt.
## Why: docs/why/ShipView.md#spool
func set_spool(look: StringName, amount: float, secs: float) -> void:
	var a := clampf(amount, 0.0, 1.0)
	if look == &"none" or a <= 0.0:
		_lace_off()
		if _spool > 0.0:
			_spool = 0.0
			refresh()
		return
	if look == &"interlace":
		_lace_on(a, secs)
		return
	_spool_look = look
	_spool = a
	_spool_t = secs
	refresh()

## Interlace is a shader so the modules, drawn by `MountPoints`, slip with the hull.
## Why: docs/why/ShipView.md#interlace
const INTERLACE_SHADER := preload("res://shaders/interlace.gdshader")
## Which rows slip is picked afresh this many times a second.
const INTERLACE_HZ := 12.0
var _lace: ShaderMaterial = null

func _lace_on(a: float, secs: float) -> void:
	if _lace == null:
		_lace = ShaderMaterial.new()
		_lace.shader = INTERLACE_SHADER
	if material != _lace:
		material = _lace
		for c in get_children():
			var ci := c as CanvasItem
			if ci != null:
				ci.use_parent_material = true
	# It stays off until the charge has some weight, then builds with it.
	_lace.set_shader_parameter("rows", JumpFx.interlace_rows * smoothstep(0.35, 1.0, a))
	_lace.set_shader_parameter("seed", floorf(secs * INTERLACE_HZ))

func _lace_off() -> void:
	if _lace == null or material != _lace:
		return
	material = null
	for c in get_children():
		var ci := c as CanvasItem
		if ci != null:
			ci.use_parent_material = false

func _clear_at(img: Image, x: int, y: int) -> bool:
	return x < 0 or y < 0 or x >= img.get_width() or y >= img.get_height() or img.get_pixel(x, y).a <= 0.0

func _noise(x: int, y: int, n: int) -> float:
	return fposmod(sin(float(x) * 12.9898 + float(y) * 78.233 + float(n) * 37.719) * 43758.5453, 1.0)

## A copy of the hull with the current spool look drawn onto its pixels.
func _spooled(img: Image) -> Image:
	var out := img.duplicate() as Image
	var r := _body_px if _body_px.size.x > 0 else Rect2i(0, 0, img.get_width(), img.get_height())
	var x0 := r.position.x
	var x1 := r.end.x
	var y0 := r.position.y
	var y1 := r.end.y
	var w := float(maxi(x1 - x0, 1))
	var a := _spool
	var t := _spool_t
	var core := Color("#e4f2ff")
	var cold := Color("#9fd0e4")
	match _spool_look:
		&"frost":
			# A cold tint washing over the plating from the stern to the nose.
			var front := x0 + int(w * clampf(t / 1.2, 0.0, 1.0))
			for y in range(y0, y1):
				for x in range(x0, mini(x1, front)):
					var c: Color = img.get_pixel(x, y)
					if c.a > 0.0:
						out.set_pixel(x, y, Color(c.lerp(cold, 0.45 * a), c.a))
		&"scan":
			# A narrow band of light running along the hull, stern to nose, again and again.
			var sx := float(x0) + fposmod(t * w / 0.9, w)
			for y in range(y0, y1):
				for x in range(maxi(x0, int(sx) - 2), mini(x1, int(sx) + 3)):
					var c: Color = img.get_pixel(x, y)
					if c.a > 0.0:
						var k := clampf(0.75 * a * (1.0 - absf(float(x) - sx) / 3.0), 0.0, 1.0)
						out.set_pixel(x, y, Color(c.lerp(core, k), c.a))
		&"rim":
			# The hull's own outline lighting up.
			for y in range(y0, y1):
				for x in range(x0, x1):
					var c: Color = img.get_pixel(x, y)
					if c.a <= 0.0:
						continue
					if _clear_at(img, x - 1, y) or _clear_at(img, x + 1, y) or _clear_at(img, x, y - 1) or _clear_at(img, x, y + 1):
						out.set_pixel(x, y, Color(c.lerp(cold, 0.85 * a), c.a))
		&"static":
			# Single points of the plating flickering, more of them as it builds.
			var n := int(t * 18.0)
			var p := 0.015 + 0.06 * a
			for y in range(y0, y1):
				for x in range(x0, x1):
					var c: Color = img.get_pixel(x, y)
					if c.a > 0.0 and _noise(x, y, n) < p:
						out.set_pixel(x, y, Color(c.lerp(core, 0.8), c.a))
		&"pulse":
			# The whole hull brightening on the seam's own pulse.
			var k := 0.35 * a * JumpFx.pulse_at(t)
			for y in range(y0, y1):
				for x in range(x0, x1):
					var c: Color = img.get_pixel(x, y)
					if c.a > 0.0:
						out.set_pixel(x, y, Color(c.lerp(cold, k), c.a))
		&"bands":
			# Bright bands flowing through the plating toward the nose.
			for x in range(x0, x1):
				var b := pow(maxf(sin(float(x - x0) * 0.16 - t * 10.0), 0.0), 6.0)
				if b < 0.02:
					continue
				for y in range(y0, y1):
					var c: Color = img.get_pixel(x, y)
					if c.a > 0.0:
						out.set_pixel(x, y, Color(c.lerp(core, 0.55 * a * b), c.a))
		&"ghost":
			# A one-pixel echo of the silhouette, cyan above and violet below.
			var hi := Color(JumpFx.ION_HI, 0.7 * a)
			var lo := Color(JumpFx.ION_LO, 0.7 * a)
			for y in range(y0, y1):
				for x in range(x0, x1):
					if img.get_pixel(x, y).a <= 0.0:
						continue
					if y - 1 >= 0 and img.get_pixel(x, y - 1).a <= 0.0:
						out.set_pixel(x, y - 1, hi)
					if y + 1 < img.get_height() and img.get_pixel(x, y + 1).a <= 0.0:
						out.set_pixel(x, y + 1, lo)
		&"drain":
			# The hull darkening, as if the charge were pulling the light out of it.
			for y in range(y0, y1):
				for x in range(x0, x1):
					var c: Color = img.get_pixel(x, y)
					if c.a > 0.0:
						out.set_pixel(x, y, Color(c.darkened(0.45 * a), c.a))
	# `interlace` is not here: it is the shader, so the modules slip too. See _lace_on.
	return out

## Put back only what was taken: `park()` once lit the hover outline amber (Jon, Oct 13).
## Why: docs/why/ShipView.md#hidden-fittings
var _fittings_hidden: Array[Control] = []

func _hide_fittings(gone: bool) -> void:
	if gone:
		for c in get_children():
			var ctrl := c as Control
			if ctrl != null and ctrl.visible:
				ctrl.visible = false
				_fittings_hidden.append(ctrl)
		return
	for ctrl in _fittings_hidden:
		if is_instance_valid(ctrl):
			ctrl.visible = true
	_fittings_hidden.clear()

func _shift(dx: int) -> bool:
	if dx == int(position.x):
		return false
	position.x = float(dx)
	return true

## The control is bigger than the ship, so aim at this, not the box (a flare ring was too big).
## Why: docs/why/ShipView.md#hull-rect
func hull_rect() -> Rect2:
	var t := Vector2(float(_w * _k), float(_h * _k))
	return Rect2((size - t) * 0.5, t)

## The middle is the body's, not the picture's: masts put the beam 28 px above the hull.
## Why: docs/why/ShipView.md#hull-body
func hull_body() -> Rect2:
	var r := hull_rect()
	if _body_px.size.x <= 0:
		return r
	var shift := 0.0
	if _body_mid >= 0.0:
		shift = (float(_bob_amp + _bob_off) + _body_mid - float(_h) * 0.5) * float(_k)
	return Rect2(r.position.x + float(_body_px.position.x), r.position.y + shift,
		float(_body_px.size.x), r.size.y)

## Body middle: rows at least half the widest, measured on the Korvan set to fix 28 px and 6 px.
func _body_middle(img: Image) -> float:
	var used := img.get_used_rect()
	var spans := PackedInt32Array()
	spans.resize(img.get_height())
	var widest := 0
	for y in range(used.position.y, used.end.y):
		var x0 := -1
		for x in range(used.position.x, used.end.x):
			if img.get_pixel(x, y).a > 0.0:
				x0 = x
				break
		if x0 < 0:
			continue
		var x1 := x0
		for x in range(used.end.x - 1, x0, -1):
			if img.get_pixel(x, y).a > 0.0:
				x1 = x
				break
		spans[y] = x1 - x0 + 1
		widest = maxi(widest, spans[y])
	var top := -1
	var bot := -1
	for y in range(used.position.y, used.end.y):
		if widest > 0 and spans[y] * 2 >= widest:
			if top < 0:
				top = y
			bot = y + 1
	if top < 0:
		return float(img.get_height()) * 0.5
	return (float(top) + float(bot)) * 0.5

## Hidden by `arrive` until its first real tick; shown again by that, or by a park.
var _arrive_hid := false

func _unhide_arrival() -> void:
	if _arrive_hid:
		_arrive_hid = false
		visible = true


## Parking is one end state for three callers, so a skip need not repeat six assignments.
## Why: docs/why/ShipView.md#park
func park() -> void:
	_unhide_arrival()
	_arrive_at = -1
	arrive_driven = false
	_arrive_dx = 0
	_arrive_span = 0
	_depart_at = -1
	_melt = -1.0
	_hide_fittings(false)
	position = Vector2.ZERO
	_shake = 0.0
	_shake_step = -1
	_spool = 0.0
	_lace_off()
	_burning = false
	_arrive_window = -1
	_sputter_e = -1.0
	_engines_off = false
	_bob_amp = _arrive_bob

## The flame follows the row's spans, with no formula: the sound was cut from those spans.
func _flame_lit(e: float) -> bool:
	return _flame_window(e) >= 0

## The flame steps down through the lit windows: FULL, then CRUISE, then IDLE, as the drive starves.
func _flame_window(e: float) -> int:
	var spans: Array = FLAMEOUTS[_flameout]
	for i in spans.size():
		var span: Vector2 = spans[i]
		if e >= span.x and e < span.y:
			return i
	return -1

## Rows are dropped, never scaled: squashing the sprite would resample a pixel face.
## Why: docs/why/ShipView.md#melt
func _paste_hull(img: Image, dy: int, blend: bool) -> void:
	if _melt <= 0.0:
		_paste(_spooled(img) if _spool > 0.0 else img, 0, dy, blend)
		return
	var w := img.get_width()
	var h := img.get_height()
	# Onto the middle of the HULL, the row the beam is aimed at -- see hull_body.
	# Eaten from both sides until the farther edge is gone too.
	var cy := int(round(_body_mid)) if _body_mid >= 0.0 else h / 2
	var e := 1.0 - pow(1.0 - _melt, 2.0)
	var reach := maxi(cy, h - cy)
	var half := int(round(float(reach) * (1.0 - e)))
	if half > 0:
		var top := maxi(0, cy - half)
		var rows := mini(h, cy + half) - top
		if rows > 0:
			var r := Rect2i(0, top, w, rows)
			var at := Vector2i(0, dy + top)
			if blend:
				_img.blend_rect(img, r, at)
			else:
				_img.blit_rect(img, r, at)
	# No line of its own: it outlived the ship and stamped a white bar under the beam's look.

## Clip at the left edge by trimming the source rect: a negative destination is not allowed.
## Why: docs/why/ShipView.md#left-edge-clip
func _paste(img: Image, dx: int, dy: int, blend: bool) -> void:
	var sx := maxi(0, -dx)
	var iw := img.get_width() - sx
	if iw <= 0:
		return
	var src := Rect2i(sx, 0, iw, img.get_height())
	var at := Vector2i(maxi(0, dx), dy)
	if blend:
		_img.blend_rect(img, src, at)
	else:
		_img.blit_rect(img, src, at)

## One place chooses the picture so the sector map's ship is the hull LOCAL draws.
## Why: docs/why/ShipView.md#hull-art
static func hull_art(h: HullData, pilot: String, half: bool) -> Texture2D:
	if h == null:
		return null
	var src: Texture2D = h.sprite
	if half and h.sprite_half != null:
		src = h.sprite_half
	if HullGrade.key_for(h) != "":
		src = HullGrade.graded_tex(h, half and h.sprite_half != null, HullWear.seed_for(h, pilot, Rng.master))
	return src


func _blit_sprite() -> void:
	# Real art is worn by hull points, closing a gap: a sprite hull looked fresh at one hull point.
	# Why: docs/why/ShipView.md#hull-wear
	var h := _hull()
	var b := _b()
	var band := HullWear.band_for(b.damage() if b != null else 0.0)
	# Wear seeds from ship, pilot and run, which both screens agree on, so a peer's damage matches.
	var wseed := HullWear.seed_for(h, b.pilot if b != null else "", Rng.master)
	var src := hull_art(h, b.pilot if b != null else "", _half)
	var img: Image = HullWear.worn_cached(src, band, wseed)
	if img == null:
		img = src.get_image()
	if img.get_format() != Image.FORMAT_RGBA8:
		img = img.duplicate() as Image
		img.convert(Image.FORMAT_RGBA8)
	if not _body_cache.has(src):
		_body_cache[src] = img.get_used_rect()
	_body_px = _body_cache[src]
	if not _mid_cache.has(src):
		_mid_cache[src] = _body_middle(img)
	_body_mid = _mid_cache[src]
	# Pad a row when parity is odd: the half pixel crawled the hull; a global snap judders.
	# Why: docs/why/ShipView.md#half-pixel-snap
	var ch := img.get_height() + _bob_amp * 2
	if size.y > 0.0 and (int(size.y) - ch) % 2 != 0:
		ch += 1
	_resize_canvas(img.get_width(), ch)
	var dy := _bob_amp + _bob_off
	# The hull is blended over buried thrusters, as blit copies alpha and holes the flame.
	# Why: docs/why/ShipView.md#exhaust-layering
	var behind := _blit_exhaust(dy, true)
	_paste_hull(img, dy, behind > 0)
	_blit_exhaust(dy, false)

## The canvas follows whatever is being drawn into it. Cheap to call every
## refresh: it only allocates when the size actually changed.
func _resize_canvas(w: int, h: int) -> void:
	if w == _w and h == _h and _img != null:
		_img.fill(Color(0, 0, 0, 0))
		return
	_w = w
	_h = h
	_img = Image.create(_w, _h, false, Image.FORMAT_RGBA8)
	# A caller's height wins at any zoom: at 1x the canvas silently overwrote three boxes.
	# Why: docs/why/ShipView.md#resize-order
	if _fit_h > 0:
		custom_minimum_size = Vector2(_w * _k, _fit_h)
		clip_contents = self_clip and _fit_h < _h * _k
	elif _k <= 1 and not _sized:
		custom_minimum_size = Vector2(_w, _h)

## Uses `blend_rect`, since blit copies alpha and punches the flame through the hull; called twice.
## Why: docs/why/ShipView.md#exhaust-layering
func _blit_exhaust(dy: int, back: bool) -> int:
	# Strips are not drawn since Oct 13: the coded flame replaced them; kept to show the rig.
	if not draw_strips:
		return 0
	var hull := _hull()
	if not _burning:
		return 0
	# A full plume hanging off a line of light refused to dematerialise, so the drive goes late.
	if _melt > 0.45:
		return 0
	var n := 0
	for t in hull.thrusters:
		var e: Dictionary = t
		if bool(e.get("back", false)) != back:
			continue
		var tex: Texture2D = e.get("tex")
		if tex == null:
			continue
		var frames: Array = _flame_frames(tex, hull.exhaust_frames)
		if frames.is_empty():
			continue
		var f := frames[_flame_step % frames.size()] as Image
		var at: Vector2i = e.at
		_paste(f, at.x, at.y + dy, true)
		n += 1
	return n

## Cut a horizontal strip into equal frames, once per texture.
static func _flame_frames(ex: Texture2D, count: int) -> Array:
	if _flame_cache.has(ex):
		return _flame_cache[ex]
	var src := ex.get_image()
	if src.get_format() != Image.FORMAT_RGBA8:
		src = src.duplicate() as Image
		src.convert(Image.FORMAT_RGBA8)
	var n := maxi(1, count)
	var fw := src.get_width() / n
	var out: Array = []
	if fw > 0:
		for i in n:
			out.append(src.get_region(Rect2i(i * fw, 0, fw, src.get_height())))
	_flame_cache[ex] = out
	return out

# --------------------------------------------------------------- pixel helpers

func px(x: int, y: int, w: int, h: int, c: Color) -> void:
	for j in h:
		for i in w:
			var xx := x + i
			var yy := y + j
			if xx >= 0 and xx < _w and yy >= 0 and yy < _h:
				_img.set_pixel(xx, yy, c)

## Ordered 2x2 dither — how pixel art does gradients without banding.
func dither(x: int, y: int, w: int, h: int, c: Color, density: float) -> void:
	var thresholds := [0.0, 0.5, 0.75, 0.25]
	for j in h:
		for i in w:
			var t: float = thresholds[(i % 2) + (j % 2) * 2]
			if t < density:
				px(x + i, y + j, 1, 1, c)

func rivets(x: int, y: int, count: int, step: int, c: Color) -> void:
	for i in count:
		px(x + i * step, y, 1, 1, c)

# ------------------------------------------------------------------- the sprite

func draw_ship() -> void:
	# Transparent: the encounter draws one starfield behind everything, and an
	# opaque fill turns the sprite into a box sitting on top of it.
	_img.fill(Color(0, 0, 0, 0))
	_starfield(41, 30)

	var ship := _b()
	var hull := ship.hull
	var ratio := ship.heat_ratio()
	var t := minf(1.0, ratio * 0.6)

	# Cold palette shifts warm as heat climbs — the whole visual thesis.
	var dark := lerp(Color("#12181f"), Color("#241a12"), t) as Color
	var a := lerp(Color("#1d242e"), Color("#2b2018"), t) as Color
	var b := lerp(Color("#2a3340"), Color("#463122"), t) as Color
	var c := lerp(Color("#39465a"), Color("#5a4028"), t) as Color
	var hi := lerp(Color("#4d5e75"), Color("#6f5033"), t) as Color
	var metal := lerp(Color("#42505f"), Color("#5e4632"), t) as Color
	var outline := Color("#0a0e13")

	# Livery is a weak pigment shift kept off the glow, as the reactor is the only warmth source.
	# Why: docs/why/ShipView.md#manufacturer-livery
	var m: ManufacturerData = DB.manufacturers.get(hull.manufacturer)
	var livery: Color = m.colour if m != null else Color("#5a6a7a")
	if m != null:
		a = a.lerp(livery, 0.10)
		b = b.lerp(livery, 0.16)
		c = c.lerp(livery, 0.16)
		hi = hi.lerp(livery, 0.16)
		metal = metal.lerp(livery, 0.12)

	var glow: Color
	var core: Color
	if ratio <= 0.03:
		glow = lerp(Color("#1a2029"), Color("#241a12"), t) as Color
		core = Color("#141a21")
	elif ratio < 1.0:
		glow = lerp(Color("#6b3210"), UITheme.FLARE, ratio) as Color
		core = lerp(Color("#a34a18"), UITheme.HOT, ratio) as Color
	else:
		glow = Color("#ffd9a0")
		core = Color("#fff4de")

	# Ambient warm wash: an overheating ship is the brightest thing in frame.
	if ratio > 0.15:
		var wash := Color(1.0, 0.616, 0.239, 0.05 * minf(1.0, ratio))
		_blend_rect(34, 30, 120, 56, wash)
	if ratio > 1.0:
		_blend_rect(20, 22, 190, 76, Color(1.0, 0.616, 0.239, 0.10))

	# Chassis dimensions read weight class.
	var hw := 82
	var hh := 30
	match hull.weight:
		HullData.Weight.LIGHT:
			hw = 62
			hh = 22
		HullData.Weight.HEAVY:
			hw = 104
			hh = 38
	var hx := 40
	var hy := 60 - hh / 2

	# Thruster and engine block
	px(hx - 14, hy + hh / 2 - 7, 10, 14, a)
	px(hx - 18, hy + hh / 2 - 4, 5, 8, dark)
	px(hx - 22, hy + hh / 2 - 3, 4, 6, glow)
	if ratio > 0.25:
		dither(hx - 29, hy + hh / 2 - 3, 7, 6, core, minf(1.0, ratio * 0.9))

	# Main hull, top-lit with dithered shading
	px(hx - 6, hy + 2, 12, hh - 4, a)
	px(hx, hy, hw, hh, b)
	px(hx, hy, hw, 4, c)
	px(hx, hy, hw, 1, hi)
	# A one-pixel stripe in the manufacturer's actual colour keeps the livery legible.
	if m != null:
		px(hx, hy + 4, hw, 1, livery.darkened(0.25))
	dither(hx, hy + 5, hw, 4, c, 0.5)
	px(hx, hy + hh - 6, hw, 6, a)
	dither(hx, hy + hh - 10, hw, 4, a, 0.45)

	# Panel seams: dark line plus a light catch-edge is what makes plating read.
	var panels := 3
	if hull.weight == HullData.Weight.HEAVY:
		panels = 4
	elif hull.weight == HullData.Weight.LIGHT:
		panels = 2
	for i in range(1, panels):
		var pxx := hx + int(hw * float(i) / panels)
		px(pxx, hy, 1, hh, outline)
		px(pxx + 1, hy, 1, hh, c)
	rivets(hx + 4, hy + 2, int(hw / 5.0), 5, dark)
	rivets(hx + 4, hy + hh - 3, int(hw / 5.0), 5, dark)

	# Bridge and nose
	px(hx + hw, hy + 3, 18, hh - 8, b)
	px(hx + hw, hy + 3, 18, 3, c)
	px(hx + hw + 5, hy + 9, 9, 6, outline)
	px(hx + hw + 6, hy + 10, 7, 4, lerp(Color("#4a6a86"), Color("#7a5a34"), t) as Color)
	px(hx + hw + 6, hy + 10, 7, 1, lerp(Color("#7fa8c4"), Color("#c39a5a"), t) as Color)
	px(hx + hw + 18, hy + 8, 7, hh - 16, a)

	# Vent strips: the primary heat instrument, four escalating stages.
	var vents := 3
	if hull.weight == HullData.Weight.HEAVY:
		vents = 4
	elif hull.weight == HullData.Weight.LIGHT:
		vents = 2
	for i in vents:
		var vx := hx + 8 + int(i * (hw - 20) / float(vents))
		px(vx - 1, hy + 7, 9, hh - 14, outline)
		px(vx, hy + 8, 7, hh - 16, dark)
		px(vx + 1, hy + 9, 5, hh - 18, glow)
		px(vx + 2, hy + 11, 3, hh - 22, core)
		if ratio > 0.6:
			dither(vx - 3, hy + 5, 13, hh - 10, core, (ratio - 0.6) * 0.8)

	_draw_modules(hx, hy, hw, hh, metal, outline)

	# Late-stage heat: lit seams, then hull-wide dither.
	if ratio > 0.5:
		px(hx + 4, hy + hh - 8, hw - 8, 1, glow)
	if ratio > 0.85:
		px(hx, hy - 1, hw, 1, core)
	if ratio > 1.0:
		dither(hx, hy, hw, hh, core, (ratio - 1.0) * 0.5)

	# A showroom hull is undamaged because `ShipBuild.showroom()` gives it full hull points.
	var dmg := ship.damage()
	if dmg > 0.3:
		px(hx + int(hw * 0.4), hy + 6, 7, 6, Color("#1a1010"))
	if dmg > 0.6:
		px(hx + int(hw * 0.65), hy + hh - 12, 9, 7, Color("#1a1010"))
		px(hx + int(hw * 0.2), hy + 2, 6, 4, Color("#3a1a10"))

## Position comes from `m.mount`, not array order, or removing a gun slid the others.
## Why: docs/why/ShipView.md#mount-positions
func _draw_modules(hx: int, hy: int, hw: int, hh: int, metal: Color, outline: Color) -> void:
	for part in _b().parts:
		var at := maxi(int(part.get("mount", 0)), 0)
		var manufacturer := StringName(part.get("manufacturer", &""))
		match int(part.get("slot", ModuleData.Slot.WEAPON)):
			ModuleData.Slot.WEAPON: _draw_weapon(manufacturer, at, hx, hy, hw, hh, metal, outline)
			ModuleData.Slot.SYSTEM: _draw_system(manufacturer, at, hx, hy, hh)
			_: _draw_util(manufacturer, at, hx, hy)

func _draw_weapon(manufacturer: StringName, at: int, hx: int, hy: int, hw: int, hh: int,
		metal: Color, outline: Color) -> void:
	var col := DB.manufacturer_colour(manufacturer)
	var dark := lerp(col, Color("#0a0e13"), 0.55) as Color
	var lite := lerp(col, Color.WHITE, 0.25) as Color
	match at:
		0:  # dorsal ordnance
			px(hx + 14, hy - 10, 30, 10, dark)
			px(hx + 14, hy - 10, 30, 3, col)
			px(hx + 14, hy - 10, 30, 1, lite)
			px(hx + 44, hy - 8, 44, 6, metal)
			px(hx + 44, hy - 8, 44, 1, lite)
			px(hx + 88, hy - 7, 3, 4, outline)
		1:  # ventral twin barrels
			px(hx + hw - 24, hy + hh, 26, 8, dark)
			px(hx + hw - 24, hy + hh, 26, 2, col)
			px(hx + hw + 2, hy + hh + 1, 30, 3, metal)
			px(hx + hw + 2, hy + hh + 5, 30, 3, metal)
			px(hx + hw + 2, hy + hh + 1, 30, 1, lite)
		2:  # aft mount
			px(hx + 6, hy + hh, 20, 10, dark)
			px(hx + 6, hy + hh, 20, 2, col)
			px(hx + 26, hy + hh + 3, 22, 4, metal)
			px(hx + 48, hy + hh + 4, 3, 2, outline)
		_:  # upper spine
			px(hx + 30, hy - 19, 16, 9, dark)
			px(hx + 30, hy - 19, 16, 2, col)
			px(hx + 46, hy - 17, 26, 4, metal)

func _draw_system(manufacturer: StringName, at: int, hx: int, hy: int, hh: int) -> void:
	var col := DB.manufacturer_colour(manufacturer)
	var bx := hx + 10 + at * 22
	px(bx, hy + hh - 4, 16, 7, lerp(col, Color("#0a0e13"), 0.5) as Color)
	px(bx, hy + hh - 4, 16, 2, col)
	px(bx + 2, hy + hh - 1, 3, 2, lerp(col, Color.WHITE, 0.3) as Color)

func _draw_util(manufacturer: StringName, at: int, hx: int, hy: int) -> void:
	var col := DB.manufacturer_colour(manufacturer)
	var ux := hx + 18 + at * 20
	px(ux, hy - 7, 5, 7, lerp(col, Color("#0a0e13"), 0.4) as Color)
	px(ux + 1, hy - 11, 3, 5, col)
	px(ux + 1, hy - 13, 3, 2, lerp(col, Color.WHITE, 0.4) as Color)

func _starfield(seed_value: int, count: int) -> void:
	var s := seed_value
	for i in count:
		s = (s * 9301 + 49297) % 233280
		var x := int(float(s) / 233280.0 * _w)
		s = (s * 9301 + 49297) % 233280
		var y := int(float(s) / 233280.0 * _h)
		px(x, y, 1, 1, Color("#141c26"))

func _blend_rect(x: int, y: int, w: int, h: int, c: Color) -> void:
	for j in h:
		for i in w:
			var xx := x + i
			var yy := y + j
			if xx >= 0 and xx < _w and yy >= 0 and yy < _h:
				var base := _img.get_pixel(xx, yy)
				_img.set_pixel(xx, yy, base.lerp(c, c.a))


func _notification(what: int) -> void:
	# A flame still being built off the main thread must finish before views
	# (and, at quit, the engine) go: see ThrusterFx.wait_all.
	if what == NOTIFICATION_PREDELETE:
		ThrusterFx.wait_all()


## The PixelLab strips instead of the coded flame. Off: nothing sets it in the
## game; it is there for a before/after film.
var draw_strips: bool = false

## Coughing out and after, dark between the coughs and none at the idle: a hull
## landing in the Shipyard on its belly jets (Jon, Nov 12: "visually turn off too").
var dark_idle := false

## How hard the engines are burning right now, or -1 for no flame.
func _thrust_now() -> int:
	if draw_strips or _engines_off or _melt > 0.45:
		return -1
	var h := _hull()
	if h == null or not h.has_exhaust() or h.sprite == null:
		return -1
	if _arrive_at >= 0:
		return arrive_thrust(_arrive_window if _burning else -1)
	if _sputter_e >= 0.0:
		if dark_idle:
			return dark_cough_thrust(_flame_window(_sputter_e))
		return arrive_thrust(_flame_window(_sputter_e))
	if _burning:
		return _burn_thrust
	return -1 if dark_idle else ThrusterFx.Thrust.IDLE


## Only your own ships hum at idle (Jon, Oct 13): a bed under every ship would be mud.
## Why: docs/why/ShipView.md#idle-hum
var hums := false:
	set(v):
		hums = v
		if v:
			Audio.idle_from(self)


## Arrival coughs count as idle, so the bed stays up and does not pump with each flash.
## Why: docs/why/ShipView.md#idle-hum
func idle_heard() -> bool:
	if not hums or not is_inside_tree() or not is_visible_in_tree():
		return false
	var th := _thrust_now()
	var settling := ((_arrive_at >= 0 and _arrive_window >= 1) or _sputter_e >= 0.0) and th >= 0
	if th != ThrusterFx.Thrust.IDLE and not settling:
		return false
	var h := hull_rect()
	var xf := get_global_transform()
	var r := Rect2(xf * h.position, Vector2.ZERO).expand(xf * h.end)
	return r.intersects(get_viewport_rect())


## The arrival sputters down to idle and never goes out (Jon, Oct 13), to avoid off then on.
## Why: docs/why/ShipView.md#arrival-sputter
## Putting out for good (`dark_idle`): the first cough a cruise flame, the rest the
## idle's, dark between them and after (Jon, Nov 12: "turn off actually when they putter out").
static func dark_cough_thrust(window: int) -> int:
	if window < 0:
		return -1
	return ThrusterFx.Thrust.CRUISE if window == 0 else ThrusterFx.Thrust.IDLE


static func arrive_thrust(window: int) -> int:
	if window < 0:
		return ThrusterFx.Thrust.IDLE
	if window <= 2:
		return ThrusterFx.Thrust.FULL
	return ThrusterFx.Thrust.CRUISE


## The coded flame uses the hull's canvas transform, so it follows bob, zoom and the half sheet.
func _draw_flame(ci: CanvasItem) -> void:
	_draw_lights(ci)
	var th := _thrust_now()
	if th < 0:
		return
	var fx := ThrusterFx.for_view(_hull(), _half and _hull().sprite_half != null)
	if fx == null:
		return
	var t := shot_clock if shot_clock >= 0.0 else GameClock.now()
	ci.draw_set_transform(canvas_to_local(Vector2.ZERO), 0.0, Vector2(float(_k), float(_k)))
	fx.draw(ci, Vector2.ZERO, th, t, false)
	ci.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)


## The engines' light for RADIANT's backdrop (`LocalSky._engine_light`); {} when no flame is drawn.
## Why: docs/why/ShipView.md#engine-glow
func engine_glow() -> Dictionary:
	var th := _thrust_now()
	if th < 0 or not is_visible_in_tree():
		return {}
	var fx := ThrusterFx.for_view(_hull(), _half and _hull().sprite_half != null)
	if fx == null or fx.nozzles.is_empty():
		return {}
	var s := Vector2.ZERO
	var n := 0
	var dir := -1.0
	for nz: Dictionary in fx.nozzles:
		for p: Vector2 in (nz.pts as PackedVector2Array):
			s += p
			n += 1
		dir = float(nz.get("dir", -1))
	if n == 0:
		return {}
	var g := get_global_transform()
	return {"at": g * (canvas_to_local(Vector2.ZERO) + s / float(n) * float(_k)), "dir": dir,
		"k": [0.55, 1.0, 1.4][clampi(th, 0, 2)], "warm": fx.warm, "scale": g.get_scale().x * float(_k)}


## Hull lights use the game clock, added like the flame; none at zero hull (Jon, Oct 14).
func _draw_lights(ci: CanvasItem) -> void:
	var h := _hull()
	if HullGrade.key_for(h) == "" or _engines_off:
		return
	var b := _b()
	if b != null and b.damage() >= 1.0:
		return
	var t := shot_clock if shot_clock >= 0.0 else GameClock.now()
	ci.draw_set_transform(canvas_to_local(Vector2.ZERO), 0.0, Vector2(float(_k), float(_k)))
	HullGrade.draw_lights(ci, h, t, 0.5 if _half and h.sprite_half != null else 1.0)
	ci.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
