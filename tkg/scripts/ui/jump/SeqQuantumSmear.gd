var P := Vector2.ZERO
var sx0 := 0.0
var sy0 := 0.0
var sw := 0.0
var sh := 0.0
var psx := 0.0
var psy := 0.0
var mid_y := 0.0
var ink_off := Vector2.ZERO
var _ghost_vp: SubViewport
var _ghost_q: SubViewport
var _back: SubViewport
var _front: SubViewport
var _ghosts: JumpGhosts = null
var _ghosts_q: JumpGhosts = null
var _lines: JumpLines
var _dots: JumpDots
## The cloud as it froze: positions, weights, which ships the snap takes.
var _gh_x := PackedFloat32Array()
var _gh_y := PackedFloat32Array()
var _gh_w := PackedFloat32Array()
var _gh_on: Array[bool] = []
## The cloud this instant (`_ghost_positions`): top-left x and y, weight, shown.
var _gx := PackedFloat32Array()
var _gy := PackedFloat32Array()
var _gw := PackedFloat32Array()
var _gs: Array[bool] = []
## The snap frames shown so far, so each gets a frame however the frames fall.
var _snap := 0


func _init() -> void:
	id = &"r5"
	length = 10.5
	hit_t = T_SNAP
	cut_t = CUT
	commit_t = 8.8
	flash_floor = 0.16


## 0..1 how spread the ship is; frozen through the hold.
static func smear(t: float) -> float:
	if t < T_WAKE:
		return 0.0
	if t < T_SMEAR:
		return 0.10 * ease3((t - T_WAKE) / (T_SMEAR - T_WAKE))
	return 0.10 + 0.90 * pow(ease3((minf(t, T_HOLD) - T_SMEAR) / (T_HOLD - T_SMEAR)), 1.25)


## A normal draw from two held draws.
static func _nrm(step_i: int, salt: int) -> float:
	return sqrt(-2.0 * log(maxf(held_rand(step_i, salt), 1e-6))) * cos(TAU * held_rand(step_i, salt + 1))


func setup(_stage: JumpStage, _place: JumpPlace, _hull: JumpHull) -> void:
	super(_stage, _place, _hull)
	stage.build(SHADER, place.window)
	sx0 = place.ink.position.x
	sy0 = place.ink.position.y
	sw = place.ink.size.x
	sh = place.ink.size.y
	mid_y = sy0 + roundf(MID_K * sh)
	ink_off = place.ink.position - place.canvas.position
	P = Vector2(place.ink.end.x + roundf(place.ahead(P_AHEAD)), mid_y - roundf(place.along(20.0)))
	psx = floorf(P.x - sw / 2.0)
	psy = P.y - roundf(MID_K * sh)
	stage.set1(&"P", P)
	stage.set1(&"core", place.core)
	stage.set1(&"ship", Vector4(place.canvas.position.x, place.canvas.position.y, place.canvas.size.x, place.canvas.size.y))
	stage.set1(&"haze_on", 0.0 if DisplaySettings.graphics_low else 1.0)
	_ghost_vp = stage.light(&"ghosts")
	_ghost_q = stage.light(&"ghosts_q", 0.25)
	_back = stage.light(&"light_back")
	_front = stage.light(&"light_front")
	_lines = JumpLines.new(NG, 0)
	_lines.set_p(&"col_h", WHT)
	_lines.set_p(&"col_t", TEAL)
	_back.add_child(_lines)
	_dots = JumpDots.new()
	_front.add_child(_dots)
	_ghost_positions(T_HOLD - 1e-4)
	_gh_x = _gx.duplicate()
	_gh_y = _gy.duplicate()
	_gh_w = _gw.duplicate()
	for i in NG:
		_gh_on.append(_gs[i] or int(RANK[i]) < int(NG * 0.8))
	# the finish: R5's bloom, its flash (a floor of 0.16, a 200 px falloff, teal, seven steps)
	stage.set2(&"centre", P)
	stage.set2(&"bloom", 0.0 if DisplaySettings.graphics_low else 1.05)
	stage.set2(&"flash_r", 200.0)
	stage.set2(&"flash_amp", 2.2)
	stage.set2(&"flash_col", WHT * 0.6 + TEAL * 0.4)
	stage.set2(&"flash_lv", 7.0)


## The ghosts need the baked hull: their texture and the two instance sets are made here.
func hull_ready() -> void:
	super()
	var tex := JumpGhosts.bake(hull)
	_ghosts = JumpGhosts.new(NG * 2, tex, place.canvas.size, false)
	_ghosts_q = JumpGhosts.new(NG * 2, tex, place.canvas.size, true)
	_ghosts_q.multimesh = _ghosts.multimesh
	_ghost_vp.add_child(_ghosts)
	_ghost_q.add_child(_ghosts_q)


func _wobble(i: int, ax: int, tc: float) -> float:
	var b := (i * 2 + ax) * 6
	var v := 0.0
	for k in 3:
		v += sin(TAU * float(G_WOB[b + k * 2]) * tc + float(G_WOB[b + k * 2 + 1])) / float(1 + k)
	return v / 1.6


## Top-left x and y (ink), weight and on-flag of every probable ship at time t, into _gx...
func _ghost_positions(t: float) -> void:
	var s := smear(t)
	var tc := minf(t, T_HOLD)
	var n_act := 0 if t < T_WAKE + 0.25 else int(roundf(3.0 + float(NG - 3) * pow(minf(1.0, s / 0.85), 1.1)))
	var lean := pow(minf(1.0, s * 1.15), 1.6)
	var reach := (psx - sx0) * lean
	var sx_ := 2.0 + 34.0 * s
	var sy_ := 1.5 + 44.0 * pow(s, 1.2)
	var wob := 1.0 + 4.0 * s
	var tick := 10000 + int(floor(tc * 10.0))
	_gx.resize(NG)
	_gy.resize(NG)
	_gw.resize(NG)
	_gs.resize(NG)
	for i in NG:
		var x := sx0 + float(G_F[i]) * reach + float(G_A[i]) * sx_ + _wobble(i, 0, tc) * wob
		var y := sy0 + float(G_B[i]) * sy_ - float(G_F[i]) * (sy0 - psy) * lean + _wobble(i, 1, tc) * wob * 0.7
		# quantum hops: ten times a second some ships are briefly somewhere else in the cloud
		var tab: Array = HOP_61 if tick == 10061 else (HOP_62 if tick == 10062 else [])
		var hop := float(tab[0][i]) if not tab.is_empty() else held_rand(tick, i * 8)
		if hop < 0.10 + 0.30 * s:
			var bx := float(tab[1][i]) if not tab.is_empty() else 1.0 - pow(1.0 - held_rand(tick, i * 8 + 1), 1.0 / 3.0)
			x = sx0 + bx * reach + (float(tab[2][i]) if not tab.is_empty() else _nrm(tick, i * 8 + 2)) * sx_ * 1.2
			y = sy0 + (float(tab[3][i]) if not tab.is_empty() else _nrm(tick, i * 8 + 4)) * sy_ * 1.2
		var blink := (float(tab[4][i]) if not tab.is_empty() else held_rand(tick, i * 8 + 6)) < 0.55 - 0.25 * s
		y = clampf(y, place.window.position.y + 4.0 - 20.0, place.window.end.y - 2.0 - sh + 20.0)
		var w := float(G_W[i]) * (0.34 + 0.50 * s) * (0.75 if float(G_SC[i]) < 1.0 else 1.0)
		_gx[i] = floorf(x + 0.5)
		_gy[i] = floorf(y + 0.5)
		_gw[i] = w * 0.6 if t < T_SMEAR else w
		_gs[i] = int(RANK[i]) < n_act and blink


## The ghost quad's origin for an ink top-left, a scaled ghost kept centred as the film's.
func _origin(x: float, y: float, sc: float) -> Vector2:
	return Vector2(x + floorf(sw * (1.0 - sc) / 2.0), y + floorf(sh * (1.0 - sc) / 2.0)) - ink_off * sc


func _step_ghosts(t: float, k: float, snap_i: int) -> void:
	if _ghosts == null:
		return
	if k < 0.0:
		var any := t > T_WAKE
		if any:
			_ghost_positions(t)
		for i in NG:
			if not any or not _gs[i]:
				_ghosts.put(i, Vector2.ZERO, 1.0, 0.0, 0)
				continue
			var sc := float(G_SC[i])
			_ghosts.put(i, _origin(_gx[i], _gy[i], sc), sc, _gw[i], 1 if i % 2 == 0 else 0)
		# the frozen cloud the haze is blurred from after the snap, drawn from the hold
		for i in NG:
			_ghosts.put(NG + i, _origin(_gh_x[i], _gh_y[i], 1.0), 1.0, _gh_w[i] * 0.6 if (t >= T_HOLD and _gh_on[i]) else 0.0, 2)
	elif snap_i == 0:
		# frame 0 of the snap: every ship leaps halfway to the point
		for i in NG:
			var x := _gh_x[i] + (psx - _gh_x[i]) * 0.5
			var y := _gh_y[i] + (psy - _gh_y[i]) * 0.5
			_ghosts.put(i, _origin(floorf(x + 0.5), floorf(y + 0.5), 1.0), 1.0, _gh_w[i] * 0.30 if _gh_on[i] else 0.0, 1)
	else:
		for i in NG:
			_ghosts.put(i, Vector2.ZERO, 1.0, 0.0, 0)


## The collapse lines: every probable ship draws a line of light to the point, in four frames.
func _step_lines(snap_i: int) -> void:
	var u0 := 0.0
	var u1 := 1.0
	var b := 0.0
	match snap_i:
		0:
			u0 = 0.0
			u1 = 0.5
			b = 2.2
		1:
			u0 = 0.55
			b = 3.0
		2:
			u0 = 0.80
			b = 1.8
		3:
			u0 = 0.93
			b = 0.9
	for i in NG:
		if snap_i < 0 or snap_i > 3 or not _gh_on[i]:
			_lines.line(i, Vector2.ZERO, Vector2.ZERO, 0.0, 0.0)
			continue
		var c := Vector2(_gh_x[i] + sw / 2.0, _gh_y[i] + roundf(MID_K * sh))
		var head := c + (P - c) * u1
		var tail := c + (P - c) * u0
		_lines.line(i, head, tail, _gh_w[i] * b, _gh_w[i] * b * 0.5)


func _fringe(x: float, y: float, tc: float) -> float:
	var r1 := Vector2(x - place.core.x, (y - place.core.y) * 1.15).length()
	var r2 := Vector2(x - P.x, (y - P.y) * 1.15).length()
	return clampf(0.5 + 0.38 * cos((r1 - r2) * (TAU / 22.0) - tc * 5.5) + 0.17 * cos(r1 * (TAU / 13.0) - tc * 9.0), 0.0, 1.0)


## Quantum foam: specks blinking in the cloud, drifting and blinking out after the snap.
func _step_foam(t: float, s: float, k: float) -> void:
	var pts := PackedVector2Array()
	var cols := PackedColorArray()
	var sf := smear(T_HOLD) if k >= 0.0 else s
	if (k < 0.0 and s > 0.12) or (k >= 0.0 and k < 2.6):
		var tc := minf(t, T_HOLD)
		var lean := pow(minf(1.0, sf * 1.15), 1.6)
		var reach := (psx - sx0) * lean
		var tick := (500 + int(floor(k * 10.0))) if k >= 0.0 else (900 + int(floor(tc * 11.0)))
		var drift := (1.0 - exp(-k / 0.8)) * 1.4 if k >= 0.0 else 0.0
		var lk := JumpStage.LIGHT_K
		for i in NFOAM:
			var ff := 1.0 - pow(1.0 - held_rand(i, 41), 1.0 / 2.5)
			var x := sx0 + sw * 0.5 + ff * reach + _nrm(i, 42) * (sw * 0.35 + 30.0 * sf) + _nrm(i, 44) * 9.0 * drift
			var y := mid_y + _nrm(i, 46) * (14.0 + 34.0 * sf) - ff * (sy0 - psy) * lean + _nrm(i, 48) * 7.0 * drift
			var c := Vector3.ZERO
			if k < 0.0:
				if held_rand(tick, i) >= 0.35 * (s - 0.1) / 0.9:
					continue
				c = (WHT if i % 3 != 0 else MINT) * (0.7 + 0.8 * _fringe(floorf(x), floorf(y), tc))
			else:
				var life := 1.0 - k / (1.2 + 1.4 * held_rand(i, 50))
				if life <= 0.0 or held_rand(tick, i) >= 0.45:
					continue
				c = (WHT if i % 3 != 0 else TEAL) * 1.4 * pow(life, 0.7)
			pts.append(Vector2(floorf(x), floorf(y)))
			cols.append(Color(c.x * lk, c.y * lk, c.z * lk))
	_dots.set_dots(pts, cols)


func step(t: float) -> void:
	var s := smear(t)
	var tc := minf(t, T_HOLD)
	var k := t - T_SNAP
	var snap_i := -1
	if k >= 0.0:
		snap_i = mini(_snap, int(k * 60.0))
		_snap += 1
	stage.set1(&"t", t)
	stage.set1(&"tc", tc)
	stage.set1(&"k", k)
	stage.set1(&"s", s)
	stage.set1(&"gain", (1.0 + 0.5 * ease5((t - T_HOLD) / (T_SNAP - T_HOLD))) if k < 0.0 else 1.6)
	stage.set1(&"haze_k", (0.5 * exp(-k / 0.10) if k > 1.0 / 60.0 else 0.45) if k >= 0.0 else 1.0)
	# the glint ahead
	var gl_g := ease3((t - T_SMEAR) / (T_HOLD - T_SMEAR)) if (t > T_SMEAR and k < 0.0) else 0.0
	stage.set1(&"gl_g", gl_g)
	stage.set1(&"gl_fk", 1.0 if t >= T_HOLD else 0.55 + 0.45 * float((int(floor(t * 12.0)) * 7) % 5) / 4.0)
	stage.set1(&"gl_bar", 14.0 + 90.0 * ease5((t - T_HOLD) / 0.4) if t >= T_HOLD else 0.0)
	_step_hull(t, s, tc)
	_step_ghosts(t, k, snap_i)
	_step_lines(snap_i)
	_step_foam(t, s, k)
	# after the snap: the point, its pop, the last speck
	stage.set1(&"pt_g", ease3((k - 1.0 / 60.0) / (0.30 - 1.0 / 60.0)) if (k >= 1.0 / 60.0 and k < 0.30) else -1.0)
	stage.set1(&"pt_fk", 0.85 + 0.15 * float((int(floor(k * 12.0)) * 7) % 3) / 2.0)
	stage.set1(&"pop", exp(-maxf(k - 0.34, 0.0) / 0.14) if k >= 0.30 else 0.0)
	stage.set1(&"speck", (1.0 - (k - 0.36) / 2.04) * (0.6 + 0.4 * float(int(floor(k * 9.0)) % 2)) if (k > 0.36 and k < 2.4) else 0.0)
	# the finish: the snap's flashes, the fringe and a 4 px shake
	var fl := 0.0
	if snap_i >= 0:
		fl = [0.35, 0.95, 0.45, 0.22, 0.12][snap_i] if snap_i < 5 else 0.12 * exp(-(k - 5.0 / 60.0) / 0.10)
		if k > 0.33 and k < 0.37:
			fl = maxf(fl, 0.5)
	set_flash(fl, P, 1.3)
	stage.set2(&"fringe", 4.0 * exp(-k / 0.13) if (k >= 0.0 and k < 0.55) else 0.0)
	var sh2 := Vector2.ZERO
	if k >= 1.0 / 60.0 and k < 0.5:
		var a := 4.0 * exp(-(k - 1.0 / 60.0) / 0.13)
		sh2 = Vector2(smooth_noise(t, 0, 15.0, 3) * a, smooth_noise(t, 1, 15.0, 3) * a * 0.8)
	set_shake(sh2)


## The real hull: its certainty, its tremble, the fringes' crawl and the drive's pulse.
func _step_hull(t: float, s: float, _tc: float) -> void:
	stage.set1(&"alpha", 1.0 - 0.45 * ease3((s - 0.1) / 0.9))
	var tr := Vector2.ZERO
	if s > 0.15 and t < T_HOLD:
		var fr := int(floor(t * 12.0)) + 7
		if held_rand(fr, 1) < s:
			tr.x = float(int(held_rand(fr, 2) * 3.0) - 1)
		if held_rand(fr, 3) < 0.5 * s:
			tr.y = float(int(held_rand(fr, 4) * 3.0) - 1)
	stage.set1(&"tremble", tr)
	var tw := t - T_WAKE
	stage.set1(&"hv_k", ease3(tw / 1.2))
	stage.set1(&"pul", 0.5 + 0.5 * sin(TAU * (1.2 * tw + 0.35 * tw * tw)))
	stage.set1(&"rim_k", ease3((t - T_SMEAR) / (T_HOLD - T_SMEAR)))
