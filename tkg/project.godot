; Three Kelvin — Godot 4.x project
config_version=5

[application]
config/name="Three Kelvin"
config/version="0.1.0-alpha.1"
; EXPORTED BUILDS KEEP THEIR OWN FOLDER: %APPDATA%\ThreeKelvinAlpha on Windows,
; ~/Library/Application Support/ThreeKelvinAlpha on a Mac -- saves, settings,
; flight record and logs -- so an alpha build never reads or writes the dev
; folder (Godot's app_userdata/Three Kelvin, which runs from source keep).
; ".template" is a feature only export templates have.
config/use_custom_user_dir.template=true
config/custom_user_dir_name.template="ThreeKelvinAlpha"
config/description="Chart coreward. Your modules are your deck."
run/main_scene="res://scenes/Shell.tscn"
; WRITE EVERY LOG LINE THROUGH TO godot.log AS IT IS PRINTED. A release build
; otherwise flushes the log only on an error, so a game that hangs and is ended
; from Task Manager left a 0-byte godot.log (measured on the export, Oct 18) --
; the one file a friend sends us. The game prints a few lines a minute.
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
; THE LAUNCH SCREEN, shown while the game loads, instead of Godot's logo. Three
; in assets/splash/, all 1920x1080 and cut from the game's own frames and icon;
; switching is this one image line:
;   splash_a_wordmark.png  the title's own first frame, THREE KELVIN where the
;                          title draws it, so loading runs straight into it
;                          (`Router.show_launcher` holds the wordmark through
;                          the handover)
;   splash_b_icon.png      the app icon at 3x on its own dark space
;   splash_c_title.png     the title with its galaxy, menu not drawn
; 1920x1080 because that is the window the splash is shown in (the size
; override below; the saved window mode and size apply only once the game
; runs), so Keep draws it at exactly 1:1 there. Keep rather than Disabled for
; the one other case: a screen too small for that window, where the OS hands
; back a smaller one -- Disabled would centre-crop the corner wordmark away,
; Keep shrinks the whole picture (unfiltered, so never blurred). Black ground,
; as the game's own letterbox is black.
boot_splash/image="res://assets/splash/splash_a_wordmark.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=true
boot_splash/stretch_mode=1
boot_splash/use_filter=false

[autoload]
Sig="*res://scripts/autoload/Sig.gd"
DB="*res://scripts/autoload/Database.gd"
Rng="*res://scripts/autoload/Rng.gd"
Run="*res://scripts/autoload/RunState.gd"
Router="*res://scripts/autoload/Router.gd"
Net="*res://scripts/net/NetSession.gd"
Audio="*res://scripts/autoload/Audio.gd"
Keys="*res://scripts/autoload/Keys.gd"
Hints="*res://scripts/ui/Hints.gd"
Ash="*res://scripts/ui/Ash.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/size/initial_position_type=1
window/stretch/mode="disabled"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.039, 0.055, 0.082, 1)

[gui]
timers/tooltip_delay_sec=0.25
theme/default_font_antialiasing=0
theme/default_font_hinting=0
