; Three Kelvin — Godot 4.x project
config_version=5

[application]
config/name="Three Kelvin"
config/version="0.3.2-alpha.1"
; EXPORTED BUILDS KEEP THEIR OWN FOLDER: %APPDATA%\ThreeKelvinAlpha on Windows,
; ~/Library/Application Support/ThreeKelvinAlpha on a Mac -- saves, settings,
; flight record and logs -- so an alpha build never reads or writes the dev
; folder (Godot's app_userdata/Three Kelvin, which runs from source keep).
; ".template" is a feature only export templates have.
config/use_custom_user_dir.template=true
config/custom_user_dir_name.template="ThreeKelvinAlpha"
config/description="Chart coreward. Your modules are your deck."
run/main_scene="res://scenes/Shell.tscn"
; WRITE EVERY LOG LINE THROUGH TO godot.log AS IT IS PRINTED. A release build
; otherwise flushes the log only on an error, so a game that hangs and is ended
; from Task Manager left a 0-byte godot.log (measured on the export, Oct 18) --
; the one file a friend sends us. The game prints a few lines a minute.
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
; THE LAUNCH SCREEN, shown in the launch window (display/window/size below)
; while the game loads, instead of Godot's logo. Jon's pick is B (Oct 20):
;   splash_b_icon.png      the app icon at 6 px a cell on its own dark space,
;                          768x432, LOADING under it in the game's face
; A and C are the two he did not pick, made for the old full-screen window
; (1920x1080), so they would need remaking at 768x432 to be used:
;   splash_a_wordmark.png  the title's own first frame, THREE KELVIN where the
;                          title draws it (`Router.show_launcher` holds the
;                          wordmark through the handover)
;   splash_c_title.png     the title with its galaxy, menu not drawn
; Keep draws it at 1:1 in the 768x432 window and at exactly 2x in the Mac's
; 1536x864; unfiltered, so a window the OS hands back at another size is
; never blurred. Black ground, as the game's own letterbox is black.
boot_splash/image="res://assets/splash/splash_b_icon.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=true
boot_splash/stretch_mode=1
boot_splash/use_filter=false

[autoload]
Sig="*res://scripts/autoload/Sig.gd"
DB="*res://scripts/autoload/Database.gd"
Rng="*res://scripts/autoload/Rng.gd"
Run="*res://scripts/autoload/RunState.gd"
Router="*res://scripts/autoload/Router.gd"
Net="*res://scripts/net/NetSession.gd"
Audio="*res://scripts/autoload/Audio.gd"
Keys="*res://scripts/autoload/Keys.gd"
Hints="*res://scripts/ui/Hints.gd"
Ash="*res://scripts/ui/Ash.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
; THE LAUNCH WINDOW: small, borderless, centred on the primary screen, holding
; the boot splash while the scripts load (about five seconds in the export).
; `DisplaySettings.load_and_apply` then gives it the player's saved mode and
; size, or the first launch's (`first_launch_window`); a harness gets the old
; framed 1920x1080 (`DisplaySettings.leave_launch_window`). 768x432 is the
; splash at 1:1. A Mac sizes windows in points (Godot divides by the Retina
; scale), so it asks for twice that, which is the same 768x432 on the screen
; and the splash at exactly 2x.
window/size/window_width_override=768
window/size/window_height_override=432
window/size/window_width_override.macos=1536
window/size/window_height_override.macos=864
window/size/borderless=true
; A FILM (--write-movie) keeps the old framed 1920x1080 window: the movie writer
; records at the project's window size whatever --resolution says, and every
; film tool expects 1080p frames. `movie` is the feature tag Godot sets for it.
window/size/window_width_override.movie=1920
window/size/window_height_override.movie=1080
window/size/borderless.movie=false
window/size/initial_position_type=1
window/stretch/mode="disabled"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.039, 0.055, 0.082, 1)

[gui]
timers/tooltip_delay_sec=0.25
theme/default_font_antialiasing=0
theme/default_font_hinting=0
